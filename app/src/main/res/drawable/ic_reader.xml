<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读图标(2.3.19.9):摊开的书 + 右上角翻起的一页。
  刻意不做"双箭头/交换"这类和 ic_switch_page(切换链接/主题)撞脸的形状:
  阅读是"打开一本书翻页"的意象,与切换的"来回箭头"在轮廓上完全不同。
  单色描边,由调用方 tint(FAB / NavigationView 各自着色)。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 整体放大 15%(书体占满视觉框,24dp 下更清晰) -->
    <group
        android:pivotX="12"
        android:pivotY="13"
        android:scaleX="1.15"
        android:scaleY="1.15">

    <!-- 左页 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,7.7 C10.2,6.4 7.6,5.8 4.6,5.8 L4.6,18.2 C7.6,18.2 10.2,18.8 12,20.1"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- 右页 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,7.7 C13.8,6.4 16.4,5.8 19.4,5.8 L19.4,18.2 C16.4,18.2 13.8,18.8 12,20.1"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- 书脊 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,7.7 L12,20.1"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />

    <!-- 翻起的一页:半透明实心,给出"正在读"的动感 -->
    <path
        android:fillAlpha="0.55"
        android:fillColor="#FF000000"
        android:pathData="M19.4,5.9 C16.9,6.0 14.9,6.9 13.5,8.4 C15.9,8.5 18.1,7.6 19.4,5.9 Z" />
    </group>
</vector>
