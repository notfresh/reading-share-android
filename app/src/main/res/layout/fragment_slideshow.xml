<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_default_launcher_title"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <!-- 2.3.19.8: 下拉统一走 SettingDropdown(Material exposed dropdown),此处只留宿主容器 -->
        <LinearLayout
            android:id="@+id/default_tab_dropdown_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <CheckBox
            android:id="@+id/show_mail_fab_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_show_mail_entry" />

        <CheckBox
            android:id="@+id/show_random_entry_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/setting_show_random_entry" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_fab_position_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/fab_side_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/fab_side_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/setting_fab_position_right" />

            <RadioButton
                android:id="@+id/fab_side_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_fab_position_left" />

        </RadioGroup>

        <Button
            android:id="@+id/button_link_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_browse_history_button" />

        <Button
            android:id="@+id/button_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_export_button"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_csv_format_hint"
            android:textColor="#808080"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/button_import_csv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_import_button"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/button_event_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setting_event_log_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_server_config_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_server_config_subtitle"
            android:textColor="#808080"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/setting_server_address_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/server_url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 同步设置区域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_sync_settings_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/setting_sync_secret_hint"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sync_secret_key_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>


        <TextView
            android:id="@+id/sync_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="8dp"
            android:textColor="#808080"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_reading_mode_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/reading_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/reading_mode_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_reading_mode_normal" />

            <RadioButton
                android:id="@+id/reading_mode_smooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_reading_mode_smooth" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_page_button_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/nav_button_style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/nav_button_style_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_page_button_bottom" />

            <RadioButton
                android:id="@+id/nav_button_style_floating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_page_button_floating" />

            <RadioButton
                android:id="@+id/nav_button_style_both"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_page_button_both" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_external_link_mode_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/external_link_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/external_link_mode_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_external_link_ask" />

            <RadioButton
                android:id="@+id/external_link_mode_direct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_external_link_open" />

            <RadioButton
                android:id="@+id/external_link_mode_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_external_link_block" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_override_rules_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/override_rule_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_override_rules_empty"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/override_rule_recycler"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:nestedScrollingEnabled="true" />

        <Button
            android:id="@+id/override_rule_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_override_rules_add"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_recent_tags_title"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/recent_tags_window_dropdown_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_history_max_count_label"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/search_history_max_count_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_history_max_count_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/button_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/setting_about_button" />

    </LinearLayout>
</ScrollView>
