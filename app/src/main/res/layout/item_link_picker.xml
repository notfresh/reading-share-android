<?xml version="1.0" encoding="utf-8"?>
<!--
  选择链接列表项（专用，不可与 item_link.xml 耦合）。
  布局只承载三个最常用的挑选信息：标题、URL、标签条。
  不要再往里塞 click_count / 收藏星位 / 置顶背景 等主页专属样式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools"
        android:text="标题占位" />

    <TextView
        android:id="@+id/picker_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:maxLines="1"
        android:ellipsize="middle"
        android:text="https://example.com" />

    <TextView
        android:id="@+id/picker_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorTertiary"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="空" />

</LinearLayout>