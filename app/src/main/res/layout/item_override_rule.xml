<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 主行:contextUrl + 动作选择 + 删除按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 整行点击区:contextUrl(主)+ redirectedUrl(副)。RadioGroup 和删除按钮不传透到 row click。 -->
        <LinearLayout
            android:id="@+id/override_rule_text_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/override_rule_pattern_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:singleLine="true"
                android:ellipsize="middle"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/override_rule_redirected_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray"
                android:singleLine="true"
                android:ellipsize="middle"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/override_rule_action_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/override_rule_action_ask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:padding="0dp"
                android:text="弹" />

            <RadioButton
                android:id="@+id/override_rule_action_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:padding="0dp"
                android:text="跳" />

            <RadioButton
                android:id="@+id/override_rule_action_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:padding="0dp"
                android:text="拦" />
        </RadioGroup>

        <Button
            android:id="@+id/override_rule_delete_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="删"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
