<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/override_rule_pattern_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:singleLine="true"
        android:ellipsize="middle"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <RadioGroup
        android:id="@+id/override_rule_action_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/override_rule_action_ask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:padding="0dp"
            android:text="弹" />

        <RadioButton
            android:id="@+id/override_rule_action_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:padding="0dp"
            android:text="跳" />

        <RadioButton
            android:id="@+id/override_rule_action_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:padding="0dp"
            android:text="拦" />
    </RadioGroup>

    <Button
        android:id="@+id/override_rule_delete_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="删"
        android:layout_marginStart="4dp" />

</LinearLayout>
